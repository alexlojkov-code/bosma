# Ключ Gemini Developer API (Google AI Studio). Без него приложение работает в демо-режиме (mock).
GEMINI_API_KEY=
# ID модели (PRD §8.1, риск R2)
GEMINI_MODEL=gemini-3.5-flash-lite
# live | mock
GEMINI_MODE=
# Таймаут запроса к Gemini, мс
GEMINI_TIMEOUT_MS=30000
# Лимиты запросов-вариантов с одного IP (3 запроса = 1 генерация)
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=300
# Дополнительные разрешённые Origin через запятую
ALLOWED_ORIGINS=
